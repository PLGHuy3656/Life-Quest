# LifeQuest Backend Environment Variables
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lifequest?schema=public"

# JWT Secrets (REQUIRED in production - replace with strong random values)
JWT_ACCESS_SECRET="change_me_access_secret_in_production"
JWT_REFRESH_SECRET="change_me_refresh_secret_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
BUILD_MODE=dev
