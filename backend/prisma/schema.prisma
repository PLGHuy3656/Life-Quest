generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuestType {
  SIMPLE
  QUANTITY
  DURATION
  PROGRESS
  FOCUS
}

enum ProofRequirement {
  NONE
  OPTIONAL
  REQUIRED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum PostVisibility {
  FRIENDS
  PUBLIC
  PRIVATE
}

enum AccessTier {
  FREE
  PREMIUM
}

enum CosmeticSlot {
  ATT_HAT
  ATT_GLASSES
  ATT_SCARF
  ATT_BACKPACK
  ATT_HAND_L
  ATT_HAND_R
}

enum ReactionType {
  LIKE
  CELEBRATE
  FIRE
  CLAP
}

enum MascotPlacement {
  DASHBOARD
  AUTH
  PROFILE
  ADMIN
  SOCIAL
  FOCUS
  SHOP
}

enum MascotTriggerType {
  ON_ENTER
  IDLE_2MIN
  TAP_HEAD
  TAP_TAIL
  TAP_SPAM
  SLEEP
  QUEST_COMPLETED
  STREAK_LOST
  EMPTY_STATE
  FOCUS_INTERRUPTED
}

enum ScheduleType {
  ONE_TIME
  RECURRING
}

enum ExecutionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  ABANDONED
}

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  username        String      @unique
  passwordHash    String
  status          String      @default("ACTIVE")
  planType        AccessTier  @default(FREE)
  trialEndsAt     DateTime?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  goals                  Goal[]
  quests                 Quest[]
  profile                UserProfile?
  settings               UserSettings?
  gamification           UserGamification?
  sessions               Session[]
  executions             QuestExecution[]
  sentFriendRequests     Friendship[]         @relation("SentFriendRequests")
  receivedFriendRequests Friendship[]         @relation("ReceivedFriendRequests")
  socialPosts            SocialPost[]
  postReactions          PostReaction[]
  postComments           PostComment[]
  sentPokes              Poke[]               @relation("SentPokes")
  receivedPokes          Poke[]               @relation("ReceivedPokes")
  mascotCosmetics        UserMascotCosmetic[]
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String?  @db.VarChar(100)
  bio         String?
  title       String?  @db.VarChar(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                  String   @id @default(uuid())
  userId              String   @unique
  timezone            String   @default("UTC") @db.VarChar(100)
  language            String   @default("vi") @db.VarChar(10)
  privacyMode         String   @default("FRIENDS") @db.VarChar(20)
  notificationEnabled Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserGamification {
  userId      String   @id
  totalXp     BigInt   @default(0)
  level       Int      @default(1)
  coinBalance BigInt   @default(0)
  updatedAt   DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  startDate   DateTime
  dueDate     DateTime
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  use        User        @relation(fields: [userId], references: [id])
  milestones Milestone[]
  quests     Quest[]
}

model Milestone {
  id          String    @id @default(uuid())
  goalId      String
  title       String
  description String?
  position    Int
  status      String    @default("ACTIVE")
  completedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  goal   Goal    @relation(fields: [goalId], references: [id])
  quests Quest[]

  @@unique([goalId, position])
}

model Quest {
  id                       String           @id @default(uuid())
  userId                   String
  goalId                   String?
  milestoneId              String?
  title                    String
  description              String?
  type                     QuestType        @default(SIMPLE)
  priority                 Int              @default(0) @db.SmallInt
  proofRequirement         ProofRequirement @default(NONE)
  targetValue              Decimal?         @db.Decimal(12, 2)
  targetUnit               String?          @db.VarChar(50)
  estimatedDurationSeconds Int?
  xpReward                 Int              @default(0)
  coinReward               Int              @default(0)
  startAt                  DateTime?
  dueAt                    DateTime?
  completedAt              DateTime?
  archivedAt               DateTime?
  status                   String           @default("ACTIVE")
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  deletedAt                DateTime?
  isPinned                 Boolean          @default(false)

  user       User             @relation(fields: [userId], references: [id])
  goal       Goal?            @relation(fields: [goalId], references: [id])
  milestone  Milestone?       @relation(fields: [milestoneId], references: [id])
  schedules  QuestSchedule[]
  executions QuestExecution[]
}

model QuestSchedule {
  id             String       @id @default(uuid())
  questId        String
  scheduleType   ScheduleType @default(ONE_TIME)
  timezone       String       @db.VarChar(100)
  startAt        DateTime
  endAt          DateTime?
  recurrenceRule Json?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  quest      Quest            @relation(fields: [questId], references: [id], onDelete: Restrict)
  executions QuestExecution[]
}

model QuestExecution {
  id              String          @id @default(uuid())
  questId         String
  userId          String
  scheduleId      String?
  status          ExecutionStatus @default(PLANNED)
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  abandonedAt     DateTime?
  progressValue   Decimal         @default(0) @db.Decimal(12, 2)
  durationSeconds Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  quest    Quest          @relation(fields: [questId], references: [id], onDelete: Restrict)
  user     User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  schedule QuestSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  receiverId  String
  status      FriendshipStatus @default(PENDING)
  blockedById String?
  acceptedAt  DateTime?
  blockedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("SentFriendRequests", fields: [requesterId], references: [id])
  receiver  User @relation("ReceivedFriendRequests", fields: [receiverId], references: [id])

  @@unique([requesterId, receiverId])
}

model SocialPost {
  id         String         @id @default(uuid())
  authorId   String
  content    String
  mediaUrl   String?
  sourceType String?
  sourceId   String?
  visibility PostVisibility @default(FRIENDS)
  deletedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  author    User           @relation(fields: [authorId], references: [id])
  reactions PostReaction[]
  comments  PostComment[]
}

model PostReaction {
  id        String       @id @default(uuid())
  postId    String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  post SocialPost @relation(fields: [postId], references: [id])
  user User       @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model PostComment {
  id        String     @id @default(uuid())
  postId    String
  authorId  String
  content   String
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  post   SocialPost @relation(fields: [postId], references: [id])
  author User       @relation(fields: [authorId], references: [id])
}

model Poke {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  message    String?
  createdAt  DateTime @default(now())

  sender   User @relation("SentPokes", fields: [senderId], references: [id])
  receiver User @relation("ReceivedPokes", fields: [receiverId], references: [id])
}

model MascotModel {
  id             String       @id @default(uuid())
  code           String       @unique
  name           String
  assetPath      String
  requiredTier   AccessTier   @default(FREE)
  sleepStartHour Int          @default(22)
  sleepEndHour   Int          @default(6)
  createdAt      DateTime     @default(now())

  dialogues MascotDialogue[]
  actions   MascotAction[]
  cosmetics MascotCosmetic[]
}

model MascotDialogue {
  id            String            @id @default(uuid())
  mascotModelId String
  triggerType   MascotTriggerType
  placement     MascotPlacement   @default(DASHBOARD)
  requiredTier  AccessTier        @default(FREE)
  actionType    String?
  content       String
  clipName      String?
  activity      String?
  mood          String?

  mascotModel MascotModel @relation(fields: [mascotModelId], references: [id])
}

model MascotAction {
  id              String          @id @default(uuid())
  mascotModelId   String
  code            String          @unique
  name            String
  description     String?
  clipName        String
  mood            String?
  requiredTier    AccessTier      @default(FREE)
  cooldownSeconds Int             @default(3)
  createdAt       DateTime        @default(now())

  mascotModel MascotModel @relation(fields: [mascotModelId], references: [id])
}

model MascotCosmetic {
  id            String          @id @default(uuid())
  mascotModelId String
  code          String          @unique
  name          String
  slot          CosmeticSlot
  assetKey      String
  coinPrice     Int             @default(0)
  requiredTier  AccessTier      @default(FREE)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())

  mascotModel    MascotModel          @relation(fields: [mascotModelId], references: [id])
  userCosmetics  UserMascotCosmetic[]
}

model UserMascotCosmetic {
  id         String          @id @default(uuid())
  userId     String
  cosmeticId String
  isEquipped Boolean         @default(false)
  equippedAt DateTime?
  acquiredAt DateTime        @default(now())

  user     User           @relation(fields: [userId], references: [id])
  cosmetic MascotCosmetic @relation(fields: [cosmeticId], references: [id])

  @@unique([userId, cosmeticId])
}
