generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuestType {
  SIMPLE
  QUANTITY
  DURATION
  PROGRESS
  FOCUS
}

enum ProofRequirement {
  NONE
  OPTIONAL
  REQUIRED
}

enum ScheduleType {
  ONE_TIME
  RECURRING
}

enum ExecutionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  ABANDONED
}

enum FocusStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

enum Visibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

enum MediaStatus {
  READY
  PROCESSING
  DELETED
}

enum CoinTransactionType {
  EARNED
  SPENT
  REFUNDED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum DuoStatus {
  PENDING
  ACTIVE
  COMPLETED
  DISBANDED
}

enum DuoMemberStatus {
  INVITED
  ACCEPTED
  DECLINED
  LEFT
}

enum ChallengeStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ChallengeMemberStatus {
  INVITED
  ACCEPTED
  DECLINED
  LEFT
  COMPLETED
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AiPlanStatus {
  DRAFT
  ACCEPTED
  REJECTED
  APPLIED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String
  role            String    @default("USER")
  status          String    @default("ACTIVE")
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  goals        Goal[]
  quests       Quest[]
  profile      UserProfile?
  settings     UserSettings?
  gamification     UserGamification?
  sessions         Session[]
  executions       QuestExecution[]
  media            Media[]
  xpTransactions   XpTransaction[]
  coinTransactions CoinTransaction[]
  achievements     UserAchievement[]
  inventory        UserInventory[]
  streakRules      StreakRule[]
  streaks          Streak[]
  sentFriendships     Friendship[]   @relation("FriendshipRequester")
  receivedFriendships Friendship[]   @relation("FriendshipReceiver")
  sentPokes           Poke[]         @relation("PokeSender")
  receivedPokes       Poke[]         @relation("PokeReceiver")
  socialPosts         SocialPost[]
  postReactions       PostReaction[]
  postComments        PostComment[]
  createdDuos         Duo[]          @relation("DuoCreator")
  duoMemberships      DuoMember[]
  createdChallenges   Challenge[]    @relation("ChallengeCreator")
  challengeMemberships ChallengeMember[]
  devices              Device[]
  notifications        Notification[]
  behaviorEvents       BehaviorEvent[]
  recommendations      Recommendation[]
  aiPlans              AiPlan[]
  filedReports         Report[]       @relation("ReportReporter")
  reviewedReports      Report[]       @relation("ReportReviewer")
  auditLogs            AuditLog[]     @relation("AuditActor")
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String?  @db.VarChar(100)
  bio         String?
  title       String?  @db.VarChar(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                  String   @id @default(uuid())
  userId              String   @unique
  timezone            String   @default("UTC") @db.VarChar(100)
  language            String   @default("vi") @db.VarChar(10)
  privacyMode         String   @default("FRIENDS") @db.VarChar(20)
  notificationEnabled Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserGamification {
  userId      String   @id
  totalXp     BigInt   @default(0)
  level       Int      @default(1)
  coinBalance BigInt   @default(0)
  updatedAt   DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  startDate   DateTime
  dueDate     DateTime
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  use        User        @relation(fields: [userId], references: [id])
  milestones Milestone[]
  quests     Quest[]
}

model Milestone {
  id          String    @id @default(uuid())
  goalId      String
  title       String
  description String?
  position    Int
  status      String    @default("ACTIVE")
  completedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  goal   Goal    @relation(fields: [goalId], references: [id])
  quests Quest[]

  @@unique([goalId, position])
}

model Quest {
  id                       String           @id @default(uuid())
  userId                   String
  goalId                   String?
  milestoneId              String?
  title                    String
  description              String?
  type                     QuestType        @default(SIMPLE)
  priority                 Int              @default(0) @db.SmallInt
  proofRequirement         ProofRequirement @default(NONE)
  targetValue              Decimal?         @db.Decimal(12, 2)
  targetUnit               String?          @db.VarChar(50)
  estimatedDurationSeconds Int?
  xpReward                 Int              @default(0)
  coinReward               Int              @default(0)
  startAt                  DateTime?
  dueAt                    DateTime?
  completedAt              DateTime?
  archivedAt               DateTime?
  status                   String           @default("ACTIVE")
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  deletedAt                DateTime?
  isPinned                 Boolean          @default(false)

  user       User             @relation(fields: [userId], references: [id])
  goal       Goal?            @relation(fields: [goalId], references: [id])
  milestone  Milestone?       @relation(fields: [milestoneId], references: [id])
  schedules  QuestSchedule[]
  executions QuestExecution[]
}

model QuestSchedule {
  id             String       @id @default(uuid())
  questId        String
  scheduleType   ScheduleType @default(ONE_TIME)
  timezone       String       @db.VarChar(100)
  startAt        DateTime
  endAt          DateTime?
  recurrenceRule Json?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  quest      Quest            @relation(fields: [questId], references: [id], onDelete: Restrict)
  executions QuestExecution[]
}

model QuestExecution {
  id              String          @id @default(uuid())
  questId         String
  userId          String
  scheduleId      String?
  status          ExecutionStatus @default(PLANNED)
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  abandonedAt     DateTime?
  progressValue   Decimal         @default(0) @db.Decimal(12, 2)
  durationSeconds Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  quest         Quest            @relation(fields: [questId], references: [id], onDelete: Restrict)
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  schedule      QuestSchedule?   @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  focusSessions FocusSession[]
  proofs        QuestProof[]
}

model FocusSession {
  id              String              @id @default(uuid())
  executionId     String
  startedAt       DateTime            @default(now())
  endedAt         DateTime?
  durationSeconds Int                 @default(0)
  status          FocusStatus         @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  execution       QuestExecution      @relation(fields: [executionId], references: [id], onDelete: Restrict)
  interruptions   FocusInterruption[]
}

model FocusInterruption {
  id             String       @id @default(uuid())
  focusSessionId String
  startedAt      DateTime     @default(now())
  endedAt        DateTime?
  reason         String?
  source         String?      @db.VarChar(30)
  createdAt      DateTime     @default(now())

  focusSession   FocusSession @relation(fields: [focusSessionId], references: [id], onDelete: Cascade)
}

model Media {
  id              String       @id @default(uuid())
  ownerUserId     String
  storageProvider String       @db.VarChar(30)
  storageKey      String       @unique
  originalName    String?      @db.VarChar(255)
  mimeType        String       @db.VarChar(100)
  sizeBytes       BigInt
  width           Int?
  height          Int?
  status          MediaStatus  @default(READY)
  createdAt       DateTime     @default(now())
  deletedAt       DateTime?

  owner           User         @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  proofs          QuestProof[]
  achievements    Achievement[]
  rewardItems     RewardItem[]
}

model QuestProof {
  id          String     @id @default(uuid())
  executionId String
  mediaId     String
  visibility  Visibility @default(PRIVATE)
  createdAt   DateTime   @default(now())
  deletedAt   DateTime?

  execution   QuestExecution @relation(fields: [executionId], references: [id], onDelete: Restrict)
  media       Media          @relation(fields: [mediaId], references: [id], onDelete: Restrict)
}

model XpTransaction {
  id             String   @id @default(uuid())
  userId         String
  amount         Int
  sourceType     String   @db.VarChar(50)
  sourceId       String?
  idempotencyKey String   @unique @db.VarChar(150)
  description    String?
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model CoinTransaction {
  id              String              @id @default(uuid())
  userId          String
  amount          BigInt
  transactionType CoinTransactionType
  sourceType      String              @db.VarChar(50)
  sourceId        String?
  idempotencyKey  String              @unique @db.VarChar(150)
  description     String?
  createdAt       DateTime            @default(now())

  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model Achievement {
  id               String            @id @default(uuid())
  code             String            @unique @db.VarChar(80)
  name             String            @db.VarChar(150)
  description      String?
  iconMediaId      String?
  type             String            @db.VarChar(50)
  isHidden         Boolean           @default(false)
  conditionConfig  Json
  rewardXp         Int               @default(0)
  rewardCoin       Int               @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  iconMedia        Media?            @relation(fields: [iconMediaId], references: [id], onDelete: SetNull)
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  progress      Decimal     @default(0) @db.Decimal(12, 2)
  unlockedAt    DateTime?
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)

  @@unique([userId, achievementId])
}

model RewardItem {
  id            String          @id @default(uuid())
  code          String          @unique @db.VarChar(80)
  name          String          @db.VarChar(150)
  description   String?
  category      String          @db.VarChar(50)
  priceCoin     BigInt          @default(0)
  requiredLevel Int             @default(1)
  mediaId       String?
  metadata      Json?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  media         Media?          @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  inventory     UserInventory[]
}

model UserInventory {
  id           String     @id @default(uuid())
  userId       String
  rewardItemId String
  purchasedAt  DateTime   @default(now())
  equippedAt   DateTime?
  quantity     Int        @default(1)

  user         User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  rewardItem   RewardItem @relation(fields: [rewardItemId], references: [id], onDelete: Restrict)

  @@unique([userId, rewardItemId])
}

model StreakRule {
  id          String   @id @default(uuid())
  userId      String
  ruleType    String   @db.VarChar(50)
  targetId    String?
  targetValue Decimal? @db.Decimal(12, 2)
  frequency   String   @default("DAILY") @db.VarChar(30)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  streaks     Streak[]
  duos        Duo[]
}

model Streak {
  id                String      @id @default(uuid())
  userId            String
  ruleId            String
  currentCount      Int         @default(0)
  longestCount      Int         @default(0)
  lastQualifiedDate DateTime?   @db.Date
  startedAt         DateTime?
  updatedAt         DateTime    @default(now()) @updatedAt

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule              StreakRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([userId, ruleId])
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  receiverId  String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?
  blockedAt   DateTime?

  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User             @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
}

model Poke {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())

  sender     User     @relation("PokeSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("PokeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
}

model SocialPost {
  id         String         @id @default(uuid())
  userId     String
  postType   String         @default("MANUAL") @db.VarChar(50)
  visibility Visibility     @default(FRIENDS)
  sourceType String?        @db.VarChar(50)
  sourceId   String?
  caption    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions  PostReaction[]
  comments   PostComment[]
}

model PostReaction {
  id           String     @id @default(uuid())
  postId       String
  userId       String
  reactionType String     @db.VarChar(30)
  createdAt    DateTime   @default(now())

  post         SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, reactionType])
}

model PostComment {
  id        String     @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Duo {
  id            String      @id @default(uuid())
  ruleId        String?
  createdBy     String
  status        DuoStatus   @default(PENDING)
  currentStreak Int         @default(0)
  longestStreak Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  rule          StreakRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  creator       User        @relation("DuoCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members       DuoMember[]
}

model DuoMember {
  id       String          @id @default(uuid())
  duoId    String
  userId   String
  status   DuoMemberStatus @default(INVITED)
  joinedAt DateTime        @default(now())

  duo      Duo             @relation(fields: [duoId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([duoId, userId])
}

model Challenge {
  id              String            @id @default(uuid())
  creatorId       String
  name            String            @db.VarChar(200)
  description     String?
  conditionType   String            @db.VarChar(50)
  conditionConfig Json
  startAt         DateTime
  endAt           DateTime
  status          ChallengeStatus   @default(UPCOMING)
  rewardConfig    Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  creator         User              @relation("ChallengeCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members         ChallengeMember[]
}

model ChallengeMember {
  id          String                @id @default(uuid())
  challengeId String
  userId      String
  status      ChallengeMemberStatus @default(INVITED)
  joinedAt    DateTime?
  progress    Decimal               @default(0) @db.Decimal(12, 2)
  finalScore  Decimal?              @db.Decimal(12, 2)
  rank        Int?

  challenge   Challenge             @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}

model Device {
  id           String    @id @default(uuid())
  userId       String
  platform     String    @db.VarChar(20)
  pushToken    String?
  deviceName   String?   @db.VarChar(100)
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(200)
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BehaviorEvent {
  id         String   @id @default(uuid())
  userId     String
  eventType  String   @db.VarChar(50)
  source     String?  @db.VarChar(50)
  entityType String?  @db.VarChar(50)
  entityId   String?
  metadata   Json?
  occurredAt DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id         String               @id @default(uuid())
  userId     String
  type       String               @db.VarChar(50)
  source     String               @db.VarChar(50)
  payload    Json
  status     RecommendationStatus @default(PENDING)
  createdAt  DateTime             @default(now())
  acceptedAt DateTime?
  rejectedAt DateTime?

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiPlan {
  id            String       @id @default(uuid())
  userId        String
  input         Json
  generatedPlan Json
  status        AiPlanStatus @default(DRAFT)
  model         String?      @db.VarChar(100)
  version       String?      @db.VarChar(30)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String
  targetType  String       @db.VarChar(50)
  targetId    String
  reason      String       @db.VarChar(100)
  description String?
  status      ReportStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime     @default(now())

  reporter    User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer    User?        @relation("ReportReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(50)
  entityId    String?
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
}
