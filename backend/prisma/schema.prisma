generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuestType {
  SIMPLE
  QUANTITY
  DURATION
  PROGRESS
  FOCUS
}

enum ProofRequirement {
  NONE
  OPTIONAL
  REQUIRED
}

enum ScheduleType {
  ONE_TIME
  RECURRING
}

enum ExecutionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  ABANDONED
}

enum FocusStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

enum Visibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

enum MediaStatus {
  READY
  PROCESSING
  DELETED
}

enum CoinTransactionType {
  EARNED
  SPENT
  REFUNDED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String
  status          String    @default("ACTIVE")
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  goals        Goal[]
  quests       Quest[]
  profile      UserProfile?
  settings     UserSettings?
  gamification     UserGamification?
  sessions         Session[]
  executions       QuestExecution[]
  media            Media[]
  xpTransactions   XpTransaction[]
  coinTransactions CoinTransaction[]
  achievements     UserAchievement[]
  inventory        UserInventory[]
}

model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String?  @db.VarChar(100)
  bio         String?
  title       String?  @db.VarChar(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                  String   @id @default(uuid())
  userId              String   @unique
  timezone            String   @default("UTC") @db.VarChar(100)
  language            String   @default("vi") @db.VarChar(10)
  privacyMode         String   @default("FRIENDS") @db.VarChar(20)
  notificationEnabled Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserGamification {
  userId      String   @id
  totalXp     BigInt   @default(0)
  level       Int      @default(1)
  coinBalance BigInt   @default(0)
  updatedAt   DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  startDate   DateTime
  dueDate     DateTime
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  use        User        @relation(fields: [userId], references: [id])
  milestones Milestone[]
  quests     Quest[]
}

model Milestone {
  id          String    @id @default(uuid())
  goalId      String
  title       String
  description String?
  position    Int
  status      String    @default("ACTIVE")
  completedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  goal   Goal    @relation(fields: [goalId], references: [id])
  quests Quest[]

  @@unique([goalId, position])
}

model Quest {
  id                       String           @id @default(uuid())
  userId                   String
  goalId                   String?
  milestoneId              String?
  title                    String
  description              String?
  type                     QuestType        @default(SIMPLE)
  priority                 Int              @default(0) @db.SmallInt
  proofRequirement         ProofRequirement @default(NONE)
  targetValue              Decimal?         @db.Decimal(12, 2)
  targetUnit               String?          @db.VarChar(50)
  estimatedDurationSeconds Int?
  xpReward                 Int              @default(0)
  coinReward               Int              @default(0)
  startAt                  DateTime?
  dueAt                    DateTime?
  completedAt              DateTime?
  archivedAt               DateTime?
  status                   String           @default("ACTIVE")
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  deletedAt                DateTime?
  isPinned                 Boolean          @default(false)

  user       User             @relation(fields: [userId], references: [id])
  goal       Goal?            @relation(fields: [goalId], references: [id])
  milestone  Milestone?       @relation(fields: [milestoneId], references: [id])
  schedules  QuestSchedule[]
  executions QuestExecution[]
}

model QuestSchedule {
  id             String       @id @default(uuid())
  questId        String
  scheduleType   ScheduleType @default(ONE_TIME)
  timezone       String       @db.VarChar(100)
  startAt        DateTime
  endAt          DateTime?
  recurrenceRule Json?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  quest      Quest            @relation(fields: [questId], references: [id], onDelete: Restrict)
  executions QuestExecution[]
}

model QuestExecution {
  id              String          @id @default(uuid())
  questId         String
  userId          String
  scheduleId      String?
  status          ExecutionStatus @default(PLANNED)
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  abandonedAt     DateTime?
  progressValue   Decimal         @default(0) @db.Decimal(12, 2)
  durationSeconds Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  quest         Quest            @relation(fields: [questId], references: [id], onDelete: Restrict)
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  schedule      QuestSchedule?   @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  focusSessions FocusSession[]
  proofs        QuestProof[]
}

model FocusSession {
  id              String              @id @default(uuid())
  executionId     String
  startedAt       DateTime            @default(now())
  endedAt         DateTime?
  durationSeconds Int                 @default(0)
  status          FocusStatus         @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  execution       QuestExecution      @relation(fields: [executionId], references: [id], onDelete: Restrict)
  interruptions   FocusInterruption[]
}

model FocusInterruption {
  id             String       @id @default(uuid())
  focusSessionId String
  startedAt      DateTime     @default(now())
  endedAt        DateTime?
  reason         String?
  source         String?      @db.VarChar(30)
  createdAt      DateTime     @default(now())

  focusSession   FocusSession @relation(fields: [focusSessionId], references: [id], onDelete: Cascade)
}

model Media {
  id              String       @id @default(uuid())
  ownerUserId     String
  storageProvider String       @db.VarChar(30)
  storageKey      String       @unique
  originalName    String?      @db.VarChar(255)
  mimeType        String       @db.VarChar(100)
  sizeBytes       BigInt
  width           Int?
  height          Int?
  status          MediaStatus  @default(READY)
  createdAt       DateTime     @default(now())
  deletedAt       DateTime?

  owner           User         @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  proofs          QuestProof[]
  achievements    Achievement[]
  rewardItems     RewardItem[]
}

model QuestProof {
  id          String     @id @default(uuid())
  executionId String
  mediaId     String
  visibility  Visibility @default(PRIVATE)
  createdAt   DateTime   @default(now())
  deletedAt   DateTime?

  execution   QuestExecution @relation(fields: [executionId], references: [id], onDelete: Restrict)
  media       Media          @relation(fields: [mediaId], references: [id], onDelete: Restrict)
}

model XpTransaction {
  id             String   @id @default(uuid())
  userId         String
  amount         Int
  sourceType     String   @db.VarChar(50)
  sourceId       String?
  idempotencyKey String   @unique @db.VarChar(150)
  description    String?
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model CoinTransaction {
  id              String              @id @default(uuid())
  userId          String
  amount          BigInt
  transactionType CoinTransactionType
  sourceType      String              @db.VarChar(50)
  sourceId        String?
  idempotencyKey  String              @unique @db.VarChar(150)
  description     String?
  createdAt       DateTime            @default(now())

  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model Achievement {
  id               String            @id @default(uuid())
  code             String            @unique @db.VarChar(80)
  name             String            @db.VarChar(150)
  description      String?
  iconMediaId      String?
  type             String            @db.VarChar(50)
  isHidden         Boolean           @default(false)
  conditionConfig  Json
  rewardXp         Int               @default(0)
  rewardCoin       Int               @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  iconMedia        Media?            @relation(fields: [iconMediaId], references: [id], onDelete: SetNull)
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  progress      Decimal     @default(0) @db.Decimal(12, 2)
  unlockedAt    DateTime?
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)

  @@unique([userId, achievementId])
}

model RewardItem {
  id            String          @id @default(uuid())
  code          String          @unique @db.VarChar(80)
  name          String          @db.VarChar(150)
  description   String?
  category      String          @db.VarChar(50)
  priceCoin     BigInt          @default(0)
  requiredLevel Int             @default(1)
  mediaId       String?
  metadata      Json?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  media         Media?          @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  inventory     UserInventory[]
}

model UserInventory {
  id           String     @id @default(uuid())
  userId       String
  rewardItemId String
  purchasedAt  DateTime   @default(now())
  equippedAt   DateTime?
  quantity     Int        @default(1)

  user         User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  rewardItem   RewardItem @relation(fields: [rewardItemId], references: [id], onDelete: Restrict)

  @@unique([userId, rewardItemId])
}
