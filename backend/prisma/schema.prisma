generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuestType {
  SIMPLE
  QUANTITY
  DURATION
  PROGRESS
  FOCUS
}

enum ProofRequirement {
  NONE
  OPTIONAL
  REQUIRED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  status       String    @default("ACTIVE")
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  goals  Goal[]
  quests Quest[]
}

model Goal {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  startDate   DateTime
  dueDate     DateTime
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  use        User        @relation(fields: [userId], references: [id])
  milestones Milestone[]
  quests     Quest[]
}

model Milestone {
  id          String    @id @default(uuid())
  goalId      String
  title       String
  description String?
  position    Int
  status      String    @default("ACTIVE")
  completedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  goal   Goal    @relation(fields: [goalId], references: [id])
  quests Quest[]

  @@unique([goalId, position])
}

model Quest {
  id                       String           @id @default(uuid())
  userId                   String
  goalId                   String?
  milestoneId              String?
  title                    String
  description              String?
  type                     QuestType        @default(SIMPLE)
  priority                 Int              @default(0) @db.SmallInt
  proofRequirement         ProofRequirement @default(NONE)
  targetValue              Decimal?         @db.Decimal(12, 2)
  targetUnit               String?          @db.VarChar(50)
  estimatedDurationSeconds Int?
  xpReward                 Int              @default(0)
  coinReward               Int              @default(0)
  startAt                  DateTime?
  dueAt                    DateTime?
  completedAt              DateTime?
  archivedAt               DateTime?
  status                   String           @default("ACTIVE")
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  deletedAt                DateTime?
  isPinned                 Boolean          @default(false)

  user      User       @relation(fields: [userId], references: [id])
  goal      Goal?      @relation(fields: [goalId], references: [id])
  milestone Milestone? @relation(fields: [milestoneId], references: [id])
}
