{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": {
          "node": "current"
        },
        "modules": false
      }
    ]
  ],
  "plugins": [
    ["@babel/plugin-transform-runtime"],
    [
      "module-resolver",
      {
        "root": ["./src"],
        "alias": {
          "~": "./src"
        },
        "extensions": [".js", ".json"]
      }
    ]
  ]
}
