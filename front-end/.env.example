# LifeQuest Frontend Environment Configuration
# Default dev proxy routes /api -> http://localhost:3000 (see vite.config.ts)
VITE_API_BASE_URL=/api/v1

# Explicit repository data mode in development:
# - live: calls real Backend API endpoints only (shows auth/availability states cleanly)
# - hybrid: LIVE for verified backend domains when authenticated, MOCK preview for unmerged/non-implemented domains
VITE_DATA_MODE=hybrid
