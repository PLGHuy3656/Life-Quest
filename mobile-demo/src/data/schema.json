{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LifeQuest Fox V2 Dialogue Collection",
  "type": "object",
  "required": ["category", "version", "entries"],
  "properties": {
    "category": {
      "type": "string",
      "enum": ["idle", "encouragement", "dashboard", "social", "task", "deadline", "system", "touch", "scene"]
    },
    "version": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "event", "text", "emotion"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "event": { "type": "string", "minLength": 3 },
          "text": { "type": "string", "minLength": 4, "maxLength": 140 },
          "emotion": {
            "type": "string",
            "enum": ["neutral", "happy", "curious", "encouraging", "playful", "alert", "panic", "calm"]
          },
          "weight": { "type": "number", "minimum": 0.1, "maximum": 10 },
          "timeOfDay": { "type": "string", "enum": ["morning", "afternoon", "evening", "any"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
