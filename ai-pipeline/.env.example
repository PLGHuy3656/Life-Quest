# LifeQuest AI Pipeline Environment Variables
AI_PIPELINE_PORT=8001
AI_PIPELINE_SERVICE_KEY=lifequest_local_ai_service_key

# Optional Gemini API key (if omitted, deterministic fallback runs cleanly offline)
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=12000

# Optional Tier 2 Fox Companion LLM tone polish for recommendations
AI_ENABLE_TONE_POLISH=false

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
